# scripts/local.env.sample — template for scripts/local.env
#
# scripts/local.env holds every machine- and core-specific value the helper
# scripts need (Quartus path, MiSTer host, ssh key, core name, NVRAM seed paths).
# It is gitignored so nothing personal is ever committed. This .sample file IS
# committed and is the single source of truth for what the real file should contain.
#
# QUICK START
#   1. Copy this file:            cp scripts/local.env.sample scripts/local.env
#      (or run:                   bash scripts/setup_env.sh )
#   2. Edit the MACHINE section   (host, ssh key, Quartus path) — set once per machine.
#   3. Build:                     bash scripts/build_only.sh
#      Deploy:                    bash scripts/deploy_screenshot.sh
#
# PORTING TO ANOTHER CORE
#   Drop scripts/ + tools/misterdeploy/ into the other repo. The MACHINE section is
#   identical across cores; only change the CORE section (RBF_NAME + the seed paths).
#
# Syntax note: this file is sourced by bash (`. scripts/local.env`). Use plain
# `VAR=value`, no spaces around `=`, quote paths with spaces. No `export` needed —
# the scripts read these directly.

# ============================================================================
# MACHINE — personal / per-machine. Set once; the same across every core.
# ============================================================================

# Quartus binary directory, prepended to PATH by scripts/build_only.sh so `quartus_sh`
# resolves. Point at the `bin64` under your Quartus install.
#   Windows (git-bash):  /c/intelFPGA_lite/17.0/quartus/bin64
#   Linux:               /opt/intelFPGA_lite/17.0/quartus/bin
#   macOS:               /Applications/intelFPGA_lite/17.0/quartus/bin
QUARTUS_BIN=/c/intelFPGA_lite/17.0/quartus/bin64

# MiSTer hostname or IP (mDNS `MiSTer.local` works if your network resolves it;
# a static IP is more reliable for scripted deploys).
MISTER_HOST=MiSTer.local

# MiSTer Remote (mrext) HTTP/websocket port. 8182 is the default — rarely changed.
MISTER_HTTP_PORT=8182

# SSH identity used to scp the built .rbf and seed files to the MiSTer.
# Set up passwordless key auth to root@MiSTer first; point this at that private key.
#   Windows (git-bash):  /c/Users/you/.ssh/mister
#   Linux/macOS:         ~/.ssh/mister
MISTER_SSH_KEY=~/.ssh/mister

# SSH user on the MiSTer (almost always root). Uncomment to override the default.
#MISTER_SSH_USER=root

# ============================================================================
# CORE — per-core. THIS is what you change when porting to another core.
# ============================================================================

# The core's .rbf filename, as it lives on the MiSTer and in output_files/.
# Defaults to <revision>.rbf, i.e. the basename of the single *.qsf in the repo
# root, so this only needs setting when the two differ.
RBF_NAME=MacQuadra800.rbf

# Top-level "_"-prefixed menu folder the core is launched from.
# Uncomment to override the launcher default (_Unstable).
#MISTER_CORE_FOLDER=_Unstable

# ---- boot ROM + SCSI mount seeding (optional; used by deploy_screenshot.sh) ---
# On first deploy these drop the pristine 1 MB Quadra 800 ROM as the core's
# boot.rom and pre-write MiSTer's per-slot mount memory so the main SCSI disk
# auto-mounts with no manual OSD mount. Both are create-only-if-missing: an
# existing ROM and the user's mount are never clobbered — only the .rbf is
# always re-pushed. Leave SEED_FILE empty to skip seeding entirely.
#
# The disk image itself is NOT seeded from here: it is multi-gigabyte and lives
# outside the repo. Push it once by hand (see BUILD.md, "Main SCSI disk"); the
# mount memory below just points slot 0 at wherever it landed.
SEED_FILE=releases/quadra800.rom
SEED_REMOTE=/media/fat/games/MacQuadra800/boot.rom
SEED_MOUNT_CFG=/media/fat/config/MacQuadra800.s0
SEED_MOUNT_REL=games/MacQuadra800/QuadSquad8.hda

# ---- Advanced / rarely needed ------------------------------------------------
# Override the auto-derived <UP-DIR> row offset for OSD navigation. Leave unset;
# the launcher derives it from the live menu listing. Set only if selection misses.
#MISTER_OSD_UPDIR_ROWS=1
