# --------------------------------------------------------------------------
#
# MiSTer project
#
# WARNING WARNING WARNING:
# Do not add files to project in Quartus IDE! It will mess this file!
# Add the files manually to files.qip file.
#
# --------------------------------------------------------------------------

set_global_assignment -name TOP_LEVEL_ENTITY sys_top
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_global_assignment -name LAST_QUARTUS_VERSION "17.0.2 Lite Edition"

set_global_assignment -name GENERATE_RBF_FILE ON
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name SAVE_DISK_SPACE OFF
set_global_assignment -name SMART_RECOMPILE ON
set_global_assignment -name MIN_CORE_JUNCTION_TEMP "-40"
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name TIMEQUEST_MULTICORNER_ANALYSIS OFF
set_global_assignment -name OPTIMIZE_POWER_DURING_FITTING OFF
set_global_assignment -name FINAL_PLACEMENT_OPTIMIZATION ALWAYS
set_global_assignment -name FITTER_EFFORT "STANDARD FIT"
# Speed-first fitting (the stock MiSTer template values).  These were
# briefly flipped to AGGRESSIVE AREA / TECHNIQUE AREA / duplication OFF as
# a hedge while the design was over capacity; the block-RAM conversions
# turned out to shed 26k ALMs on their own (143% -> 81%), so the hedge was
# unnecessary — and area mode costs Fmax, which the 2026-08-29 compile
# needed: it fit at 81% but missed setup by 0.947 ns (Fmax 32.0 vs the
# 33.0 MHz clock).  Do not re-apply the area knobs without a fit that
# actually needs them.
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name ALLOW_POWER_UP_DONT_CARE ON
set_global_assignment -name QII_AUTO_PACKED_REGISTERS NORMAL
set_global_assignment -name ROUTER_LCELL_INSERTION_AND_LOGIC_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_DUPLICATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_REGISTER_RETIMING ON
set_global_assignment -name OPTIMIZATION_TECHNIQUE SPEED
set_global_assignment -name MUX_RESTRUCTURE ON
set_global_assignment -name REMOVE_REDUNDANT_LOGIC_CELLS ON
set_global_assignment -name AUTO_DELAY_CHAINS_FOR_HIGH_FANOUT_INPUT_PINS ON
set_global_assignment -name PHYSICAL_SYNTHESIS_COMBO_LOGIC_FOR_AREA ON
set_global_assignment -name ADV_NETLIST_OPT_SYNTH_WYSIWYG_REMAP ON
set_global_assignment -name SYNTH_GATED_CLOCK_CONVERSION ON
set_global_assignment -name PRE_MAPPING_RESYNTHESIS ON
set_global_assignment -name ROUTER_CLOCKING_TOPOLOGY_ANALYSIS ON
set_global_assignment -name ECO_OPTIMIZE_TIMING ON
set_global_assignment -name PERIPHERY_TO_CORE_PLACEMENT_AND_ROUTING_OPTIMIZATION ON
set_global_assignment -name PHYSICAL_SYNTHESIS_ASYNCHRONOUS_SIGNAL_PIPELINING ON
set_global_assignment -name ALM_REGISTER_PACKING_EFFORT MEDIUM
# Fitter seed. At 82% ALM utilisation the placement is marginal enough that the
# 99 MHz clk_ram (SDRAM) domain's HOLD slack swings with the netlist: seed 1 gave
# +0.449 and +0.464 ns on two builds, then -0.122 ns on 2026-08-30 after an
# unrelated clk_sys change. Hold slack is a placement artifact, so reseeding is
# the right lever; if a future build violates again, try another value rather
# than assuming the RTL change caused it. Check the STA summary, not just the
# Fitter status -- scripts/deploy_screenshot.sh now refuses a violated build.
# 2026-08-30: seed 2 gave -0.283 ns hold on clk_ram after the via6522 shift-clock
# fix -- a clk_sys-domain change that cannot reach the 99 MHz domain, so it was
# the placement swinging again, not the RTL. Seed 3 fits.
# 2026-08-31: seed 3 then gave SETUP -0.435 ns and -0.165 ns on clk_sys for a
# one-line easc.sv change that REMOVES logic (the fifo_stat full flag), while
# the same tree had fitted at +0.201..+0.246 ns minutes earlier. Placement
# again, not the RTL. Seed 4 also missed (-0.393 ns setup on clk_sys, one
# endpoint, 1.3% of the 30.303 ns period). clk_sys sits at roughly 0 +/- 0.4 ns
# and flips sign with placement; the ASC does not appear in any failing path.
# Seed 5 was worse still (-1.643 ns), i.e. four straight misses trending the
# wrong way -- outside the +/-0.4 ns band this design normally swings in. Two
# fitter runs had been killed with taskkill /F mid-fit that morning and db/ +
# incremental_db/ were carried through every build after, so the state was
# suspect. Wiping both dirs changed nothing: a clean seed-3 fit reproduced
# -0.165 ns exactly, so Quartus is deterministic here and db/ was never the
# problem. report_timing names the path: ap040_core|ir[7] -> |exc_fmt[0], i.e.
# INSIDE THE CPU CORE on clk_sys -- nothing to do with whatever RTL you just
# touched. The design has ~0 ns margin there and any netlist perturbation
# flips it, so walk seeds and do not go hunting in your own diff. Tried:
# 3 -> -0.165, 4 -> -0.393, 5 -> -1.643. Seed 6 then met at +0.062 ns.
#
# 2026-09-01, after the SDRAM fast path (rtl/sdram_beat32.sv): seed 6 went
# from +0.062 to -0.952 ns. That is the same lottery, not the diff -- the
# change is 97 ALMs SMALLER than the tree it replaced (35,244 vs 35,436), and
# report_timing still names ap040_core|ir[3..4] -> |exc_fmt[0] with the loss
# sitting in clock skew (-0.538 vs -0.126). Walked again:
# 6 -> -0.952, 7 -> -1.029, 8 -> -0.501, 9 -> -1.235, 10 -> -1.008,
# 11 -> -0.176, 12 -> -0.056, 13 -> +0.132.
# Seed 13 has MORE margin than the design had before the change. Candidate
# bitstreams for every seed above are kept in scratch/seeds/ (gitignored) with
# their reports; scratch/seeds/restore_seed.sh <n> stages one for deploy.
set_global_assignment -name SEED 13

#set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"

#enable it only if 8bit indexed mode is used in core
#set_global_assignment -name VERILOG_MACRO "MISTER_FB_PALETTE=1"

#do not enable DEBUG_NOHDMI in release!
#set_global_assignment -name VERILOG_MACRO "MISTER_DEBUG_NOHDMI=1"

# disable bilinear filtering when downscaling
#set_global_assignment -name VERILOG_MACRO "MISTER_DOWNSCALE_NN=1"

# disable adaptive scanline filtering
#set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ADAPTIVE=1"

# ============================================================================
# DEBUG ONLY -- SCSI protocol tracer in rtl/iosb.sv.
#
# Uncomment to stream every first-sighting SCSI register value, bus fault and
# stray I/O address out the modem port as ASCII, readable on the MiSTer with
#     stty -F /dev/ttyS1 115200 raw -echo && cat /dev/ttyS1
# (scripts/scsi_trace.sh does deploy + capture + decode in one go).
#
# This TAKES OVER the guest's serial port -- the SCC no longer reaches the pin.
# Never ship a bitstream built with this on.  scripts/build_only.sh detects the
# line below and prints a DEBUG BUILD banner so it cannot pass unnoticed.
# ============================================================================
#set_global_assignment -name VERILOG_MACRO "SCSI_TRACE=1"

#use only 1MB per frame for scaler to free ~21MB DDR3 RAM
#set_global_assignment -name VERILOG_MACRO "MISTER_SMALL_VBUF=1"

# Disable YC / Composite output to save some resources
#set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_YC=1"

# Disable ALSA audio output to save some resources
#set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"

source sys/sys.tcl
source sys/sys_analog.tcl
source files.qip
